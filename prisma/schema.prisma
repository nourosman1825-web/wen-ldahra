// // This is your Prisma schema file,
// // learn more about it in the docs: https://pris.ly/d/prisma-schema

// // Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Place {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  image       String?
  rating      Float     @default(0)
  reviewCount Int       @default(0)
  distance    Float?    // km, if you calculate/store it
  latitude    Float?
  longitude   Float?
  category    String    // e.g. "Cafés", "Restaurants", "Parks"
  tags        String[]  // e.g. ["Quiet", "Wi-Fi", "Outdoor"]
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  favorites   Favorite[]

  @@index([category])
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String?
  password  String    // store a hashed password, never plain text
  createdAt DateTime  @default(now())

  favorites Favorite[]
}

model Favorite {
  id      Int   @id @default(autoincrement())
  user    User  @relation(fields: [userId], references: [id])
  userId  Int
  place   Place @relation(fields: [placeId], references: [id])
  placeId Int

  createdAt DateTime @default(now())

  @@unique([userId, placeId]) // prevents favoriting the same place twice
}
model Sale {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String
  image       String?
  date        String?
  isSale      Boolean  @default(false)
  discount    String?
  location    String?
  createdAt   DateTime @default(now())
}